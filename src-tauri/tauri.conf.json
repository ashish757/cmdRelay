{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cmdRelay",
  "version": "2.0.0",
  "identifier": "com.cmdrelay.daemon",
  "build": {
    "beforeDevCommand": "cd ../client && npm run dev -- --host",
    "beforeBuildCommand": "cd ../client && npm run build",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cmdRelay",
        "width": 320,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
